# --- Required ---------------------------------------------------------------

# HubSpot service key or private app token.
# HubSpot → Settings → Integrations → Service keys (or Private apps).
#
# Scopes for the content side:
#   content                             pages, blog posts, marketing emails
#   forms                               forms
#   external_integrations.forms.access  forms (v3 API)
#   files                               referencing hosted images
#   marketing.campaigns.read            campaigns (.write to create and attach)
#
# The scopes on this key are the outer limit of what any configuration below
# can reach — HubSpot enforces them server-side, so they hold even if this
# server has a bug. If you want the guarantee that a leaked token cannot touch
# customer data, grant no crm.* scope and leave ALLOW_CRM unset.
HUBSPOT_ACCESS_TOKEN=pat-xxx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# --- Recommended ------------------------------------------------------------

# Your HubSpot portal / hub ID. Used to build app.hubspot.com edit URLs.
# Without it the tools still work but return empty edit_url fields.
HUBSPOT_PORTAL_ID=12345678

# IANA timezone used when formatting social post schedules.
DEFAULT_TIMEZONE=UTC


# ---------------------------------------------------------------------------
# What this install is allowed to do
# ---------------------------------------------------------------------------
#
# These two settings decide which tools get registered at all, and which API
# paths the HTTP client will carry. Neither is a permission check the model is
# asked to respect: a surface that is off has no tool to call and no reachable
# path. Useful when your key is broader than this particular job — a shared
# service key, typically.

# ALLOW_PUBLISH — which content areas may go live. Default: all.
#   none | all | any comma-separated subset of: pages, blog, emails
#
# Set it to none for an install that can only ever produce drafts. Every
# publish, schedule and unpublish additionally requires the calling model to
# pass user_confirmed=True, and is logged at WARNING.
#
# Marketing email publishing additionally needs Marketing Hub Enterprise or the
# transactional email add-on; other tiers get a 403 that says so.
ALLOW_PUBLISH=all

# ALLOW_CRM — whether contacts, companies, deals and tickets are reachable.
# Default: none, and that default is doing real work.
#
#   none  — no CRM tool is registered and the client refuses every CRM path.
#           Nothing personal can enter the conversation, so nothing personal
#           can reach whoever runs your AI model. If that guarantee is why you
#           are here, leave this alone and scope your key to content + forms.
#   read  — search and read records, properties, owners, pipelines, lists.
#   write — the above, plus create, update, associate and list membership.
#   all   — the above, plus archiving records and switching workflows on/off.
#
# Turning this on is a real decision: every record the assistant reads is
# copied into the conversation and leaves your machine. It also needs the
# matching crm.* scopes on the key — both, not either.
ALLOW_CRM=none


# --- Optional ---------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
# DEBUG applies to this server's own loggers only; HTTP libraries stay pinned
# at WARNING so a request header can never reach the log file.
LOG_LEVEL=INFO

# Allow writing raw <head> / <footer> HTML on pages and posts.
# Off by default: a <script> tag there becomes persistent XSS on your public
# site once the page is published, and it is easy to miss when reviewing a
# draft. Turn this on only if you genuinely need to edit tracking snippets
# through the assistant.
# ALLOW_RAW_HTML=false

# Where generated files (social XLSX) are written.
# Relative paths resolve against the current working directory.
# Defaults to ./output next to this file.
# OUTPUT_DIR=./output

# Where server.log is written. Defaults to ./logs next to this file.
# LOG_DIR=./logs

# Point at a different .env explicitly. Without this, only the .env in the
# current working directory is read — parent directories are deliberately not
# searched, so an untrusted checkout cannot supply one.
# HUBSPOT_MCP_ENV_FILE=/absolute/path/to/.env

# Only api.hubapi.com, api.hubapiqa.com and localhost are accepted. The access
# token is sent here as a bearer header, so this is validated rather than
# trusted.
# HUBSPOT_API_BASE=https://api.hubapi.com
