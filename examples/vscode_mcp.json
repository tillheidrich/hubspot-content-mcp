{
  "//": "VS Code — .vscode/mcp.json in the workspace. Note the key is 'servers', not 'mcpServers', and the type must be stated.",
  "servers": {
    "hubspot-mcp-server": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "/absolute/path/to/hubspot-mcp",
        "run",
        "hubspot-mcp-server"
      ],
      "env": {
        "HUBSPOT_MCP_ENV_FILE": "/absolute/path/to/hubspot-mcp/.env",
        "ALLOW_PUBLISH": "pages,blog",
        "ALLOW_CRM": "none"
      }
    }
  }
}
